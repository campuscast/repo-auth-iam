NODE_ENV=production
PORT=3001
LOG_LEVEL=warn

# Auth — REQUIRED: generate a strong random secret (e.g. openssl rand -base64 48)
JWT_SECRET=

# Database — REQUIRED: production PostgreSQL connection string
DATABASE_URL=postgresql://campuscast:<PASSWORD>@<HOST>:5432/auth_db

# Redis — REQUIRED: production Redis URL
REDIS_URL=redis://<HOST>:6379

# Bootstrap admin — REQUIRED on first run only
AUTH_BOOTSTRAP_ADMIN_EMAIL=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=
# AUTH_BOOTSTRAP_ADMIN_ROLE=admin
# AUTH_BOOTSTRAP_ADMIN_RESET_PASSWORD=false

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
METRICS_PORT=9464
